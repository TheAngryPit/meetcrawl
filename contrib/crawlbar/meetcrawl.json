{
    "schema_version": "crawlkit.control.v1",
    "id": "meet",
    "display_name": "Meetings Index",
    "description": "Local-first meetings index with pluggable source adapters.",
    "binary": {
        "name": "meet"
    },
    "branding": {},
    "paths": {
        "default_config": "~/.config/meetcrawl/config.toml",
        "config_env": "MEETCRAWL_CONFIG",
        "default_database": "~/.local/share/meetcrawl/meetcrawl.db"
    },
    "commands": {
        "doctor": {
            "title": "Doctor",
            "argv": [
                "meet",
                "doctor",
                "--json"
            ],
            "json": true
        },
        "index": {
            "title": "Index",
            "argv": [
                "meet",
                "index",
                "--json"
            ],
            "json": true,
            "mutates": true
        },
        "metadata": {
            "title": "Metadata",
            "argv": [
                "meet",
                "metadata",
                "--json"
            ],
            "json": true
        },
        "search": {
            "title": "Search",
            "argv": [
                "meet",
                "search",
                "--json"
            ],
            "json": true
        },
        "status": {
            "title": "Status",
            "argv": [
                "meet",
                "status",
                "--json"
            ],
            "json": true
        },
        "sync-export_file": {
            "title": "Sync export-file",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "export-file"
            ],
            "json": true,
            "mutates": true
        },
        "sync-gmeet": {
            "title": "Sync gmeet",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "gmeet"
            ],
            "json": true,
            "mutates": true
        },
        "sync-grain": {
            "title": "Sync grain",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "grain"
            ],
            "json": true,
            "mutates": true
        },
        "sync-granola": {
            "title": "Sync granola",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "granola"
            ],
            "json": true,
            "mutates": true
        },
        "sync-fireflies": {
            "title": "Sync fireflies",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "fireflies"
            ],
            "json": true,
            "mutates": true
        },
        "sync-openwhispr": {
            "title": "Sync openwhispr",
            "argv": [
                "meet",
                "sync",
                "--json",
                "--source",
                "openwhispr"
            ],
            "json": true,
            "mutates": true
        }
    },
    "capabilities": [
        "metadata",
        "status",
        "doctor",
        "sync",
        "index",
        "search"
    ],
    "privacy": {
        "contains_private_messages": true,
        "exports_secrets": false,
        "local_only_scopes": [
            "openwhispr SQLite archive",
            "gmeet-gemini SQLite archive",
            "export-file SQLite archive",
            "grain SQLite archive",
            "granola SQLite archive",
            "fireflies SQLite archive",
            "meet index SQLite archive"
        ]
    }
}
