{
    "schema_version": "crawlkit.control.v1",
    "id": "meetcrawl",
    "display_name": "Meetings Index",
    "description": "Local-first meetings index with pluggable source adapters.",
    "binary": {
        "name": "meetcrawl"
    },
    "branding": {},
    "paths": {
        "default_config": "~/.config/meetcrawl/config.toml",
        "config_env": "MEETCRAWL_CONFIG",
        "default_database": "~/.local/share/meetcrawl/meetcrawl.db"
    },
    "commands": {
        "doctor": {
            "title": "Doctor",
            "argv": [
                "meetcrawl",
                "doctor",
                "--json"
            ],
            "json": true
        },
        "index": {
            "title": "Index",
            "argv": [
                "meetcrawl",
                "index",
                "--json"
            ],
            "json": true,
            "mutates": true
        },
        "metadata": {
            "title": "Metadata",
            "argv": [
                "meetcrawl",
                "metadata",
                "--json"
            ],
            "json": true
        },
        "sync": {
            "title": "Sync",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "all"
            ],
            "json": true,
            "mutates": true
        },
        "status": {
            "title": "Status",
            "argv": [
                "meetcrawl",
                "status",
                "--json"
            ],
            "json": true
        },
        "sync-circleback": {
            "title": "Sync circleback",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "circleback"
            ],
            "json": true,
            "mutates": true
        },
        "sync-export_file": {
            "title": "Sync export-file",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "export-file"
            ],
            "json": true,
            "mutates": true
        },
        "sync-fathom": {
            "title": "Sync fathom",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "fathom"
            ],
            "json": true,
            "mutates": true
        },
        "sync-fireflies": {
            "title": "Sync fireflies",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "fireflies"
            ],
            "json": true,
            "mutates": true
        },
        "sync-gmeet": {
            "title": "Sync gmeet",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "gmeet"
            ],
            "json": true,
            "mutates": true
        },
        "sync-grain": {
            "title": "Sync grain",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "grain"
            ],
            "json": true,
            "mutates": true
        },
        "sync-granola": {
            "title": "Sync granola",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "granola"
            ],
            "json": true,
            "mutates": true
        },
        "sync-krisp": {
            "title": "Sync krisp",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "krisp"
            ],
            "json": true,
            "mutates": true
        },
        "sync-openwhispr": {
            "title": "Sync openwhispr",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "openwhispr"
            ],
            "json": true,
            "mutates": true
        },
        "sync-tldv": {
            "title": "Sync tldv",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "tldv"
            ],
            "json": true,
            "mutates": true
        },
        "sync-pocket": {
            "title": "Sync pocket",
            "argv": [
                "meetcrawl",
                "sync",
                "--json",
                "--source",
                "pocket"
            ],
            "json": true,
            "mutates": true
        }
    },
    "capabilities": [
        "metadata",
        "status",
        "doctor",
        "sync",
        "index",
        "search"
    ],
    "privacy": {
        "contains_private_messages": true,
        "exports_secrets": false,
        "local_only_scopes": [
            "openwhispr SQLite archive",
            "gmeet-gemini SQLite archive",
            "export-file SQLite archive",
            "grain SQLite archive",
            "granola SQLite archive",
            "fireflies SQLite archive",
            "fathom SQLite archive",
            "krisp SQLite archive",
            "circleback SQLite archive",
            "tldv SQLite archive",
            "pocket SQLite archive",
            "meetcrawl index SQLite archive"
        ]
    }
}
